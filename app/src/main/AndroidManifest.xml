<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <uses-permission tools:node="remove" android:name="android.permission.INTERNET" />

    <application
        android:name=".Application"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Keyholm">

        <activity
            android:name=".ui.main.Activity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="keyholm" android:host="migrate" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.createpasskey.Activity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Keyholm.Transparent" />

        <activity
            android:name=".ui.getpasskey.Activity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Keyholm.Transparent" />

        <activity
            android:name=".ui.getpasskey.UnlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Keyholm.Transparent" />

        <service
            android:name=".provider.Service"
            android:enabled="true"
            android:exported="true"
            android:label="@string/provider_label"
            android:icon="@mipmap/ic_launcher"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/provider" />
        </service>

    </application>
</manifest>
